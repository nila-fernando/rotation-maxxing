# Rotation-Maxxing environment. Copy to .env (never commit .env).
# Server-only values: NO VITE_ prefix, so they never reach the browser.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_ENABLED=true
AI_RATE_LIMIT_PER_MIN=20

# Browser-visible (VITE_). Blank = same-origin /api/ai (the dev server).
# Later: the Supabase Edge Function URL.
VITE_AI_ENDPOINT=

# Next step: Supabase (logins). Anon key is safe in the browser; the service role key is NOT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# CropScape proxy for crop history (dev uses /cropscape by default).
# VITE_CDL_PROXY=
