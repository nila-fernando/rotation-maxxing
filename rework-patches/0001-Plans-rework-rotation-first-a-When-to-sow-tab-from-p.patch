+    if (dates.length === 7 && dates.slice(0, 3).every((d) => d == null)) dates = [null, ...dates];
+    if (dates.length !== 8) continue;
+    const win = (a) => (a.every((d) => d == null) ? null : { begin: a[0], activeStart: a[1], activeEnd: a[2], end: a[3] });
