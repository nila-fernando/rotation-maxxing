+      if (method === 0) return data;
+      if (method === 8) return inflateRawSync(data);
+      throw new Error(`${name}: compression method ${method} not supported`);
+    }
+    p += 46 + nLen + xLen + cLen;
+  }
+  throw new Error(`${name} not in the zip`);
+}
