new file mode 100644
index 0000000..e30f5a0
--- /dev/null
+++ b/src/styles/crop-tip.css
@@ -0,0 +1,39 @@
+/* The shared crop-name tooltip (src/ui/cropTip.js). Track C.
+   One #cropTip on <body> for every crop icon: the crop's name in bold, then a quieter line (the
+   year and what it follows, or the sowing window), or up to 3 lines for a control naming several.
+   The look of the check-up's old .ck-tip: --ink on --cream, a wood border. Above the plans panel
+   (29), the check-up (28) and the farm dock (26); never over the jar test. These rules sit at the
+   top of styles.css, so anything here that styles.css also styles uses a stronger selector. */
+.crop-tip {
+  position: fixed; left: 0; top: 0; z-index: 45; display: grid; gap: 3px; justify-items: center;
+  max-width: min(300px, calc(100vw - 16px)); padding: 5px 10px 6px; border-radius: 10px;
+  background: var(--cream); border: 3px solid var(--wood); box-shadow: 0 3px 0 var(--wood-dark), 0 8px 16px rgb(60 40 80 / .22);
+  color: var(--ink); font: 600 14px/1.2 var(--font); white-space: nowrap; text-align: center;
+  pointer-events: auto; /* hoverable: moving onto it keeps it open (WCAG 1.4.13) */
+  will-change: transform;
+}
+.crop-tip[hidden], body.jar-open .crop-tip { display: none; }
+.crop-tip__row { display: grid; justify-items: center; gap: 1px; min-width: 0; }
+.crop-tip__row b { font-weight: 700; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
+.crop-tip__row span { font-size: 12px; font-weight: 600; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
+/* a list (a ribbon row, a plan, a story's pick): one line per season, left-aligned */
+.crop-tip.crop-tip--list { justify-items: start; text-align: left; }
+.crop-tip.crop-tip--list .crop-tip__row { justify-items: start; }
+.crop-tip.crop-tip--list .crop-tip__row b { font-weight: 600; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .crop-tip:not([hidden]) { animation: crop-tip-in 90ms ease-out both; }
+}
+@keyframes crop-tip-in { from { opacity: 0; } to { opacity: 1; } }
+
+/* a bare crop icon inside a styled control (a palette button, a builder cell, a sidebar row, a
+   check-up year): a box of its own for the tip to sit on, sized by its control's svg rules */
+.crop-ico { display: inline-grid; place-items: center; flex: none; line-height: 0; }
+.hist__icon > .crop-ico { width: 100%; height: 100%; }
+.hist__icon > .crop-ico svg { width: 72%; height: 72%; }
+
+/* the boxed badge's sizes (the plain .plan-crop is md) */
+.plan-crop.plan-crop--sm { width: 24px; height: 24px; border-radius: 7px; }
+.plan-crop.plan-crop--sm svg { width: 18px; height: 18px; }
+.plan-crop.plan-crop--lg { width: 38px; height: 38px; border-radius: 11px; }
+.plan-crop.plan-crop--lg svg { width: 27px; height: 27px; }
diff --git a/src/styles/futures-rotation.css b/src/styles/futures-rotation.css
new file mode 100644
index 0000000..86ba5b3
--- /dev/null
+++ b/src/styles/futures-rotation.css
@@ -0,0 +1,53 @@
+/* On the farm: rotation chips, the Show the money toggle, rotation tiles (src/screens/planFutures.js). Track C.
+   Rotation first: a chip shows the crop, its link's sign and what it follows ("after beans"); the
+   coins, the cash on the chips and the money tiles come in with "Show the money". These rules sit
+   at the top of styles.css, so anything styles.css also styles uses a stronger selector here. */
+
+/* ---- the chips: the crop, the link sign, "after beans" */
+.fut-chip .fut-chip__link { display: inline-flex; flex: none; width: 16px; height: 16px; color: var(--ink-soft); }
+.fut-chip .fut-chip__link svg { width: 16px; height: 16px; }
+.fut-chip .fut-chip__link--nitrogen { color: var(--green-dark); }
+.fut-chip .fut-chip__link--break { color: #6b8f3a; }
+.fut-chip .fut-chip__link--repeat { color: var(--rose-dark); }
+.fut-chip .fut-chip__link--same-family { color: var(--wood-dark); }
+.fut-chip .fut-chip__after { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
+.fut-chip.fut-chip--rotation { gap: 4px; }
+/* the chip is the tap target (it opens the field's card); its badge names nothing of its own here:
+   the field's tooltip and card do (no second tooltip over the 3D) */
+.fut-chip .plan-crop, .fut-chip [data-crop-tip] { pointer-events: none; }
+
+/* ---- "Show the money" */
+.fut-dock .fut-money { flex: none; gap: 6px; }
+.fut-dock .fut-money[aria-pressed="true"] { background: #fff3c9; border-color: #d4a52c; box-shadow: 0 3px 0 #b88a1c; color: var(--ink); }
+.fut-dock .fut-money[aria-pressed="true"]:hover { background: #ffecb0; }
+.fut-dock .fut-money:focus-visible { outline: 3px solid var(--green-dark); outline-offset: 2px; }
+.fut-dock .fut-money:disabled { opacity: .55; cursor: default; }
+
+/* with the money off the dock is about the rotation: no cash under the seasons, no coin caption
+   (the caption still shows while the plans load: it carries the loading line then) */
+.fut-dock:not(.is-money) .fut-season__cash { display: none; }
+.fut-dock:not(.is-money):not(.is-loading) .fut-caption { visibility: hidden; }
+
+/* ---- the rotation tiles: "2 seasons", with keeping going's count under it */
+.fut-tile .fut-tile__base { flex-basis: 100%; font-size: 11.5px; font-weight: 600; color: var(--ink-soft); line-height: 1.2; }
+
+/* phones and tablets: the toggle sits under More, beside the tiles */
+@media (max-width: 900px) and (min-height: 521px), (max-width: 640px) {
+  .fut-dock .fut-dock__row--mid > .fut-score { grid-row: span 2; }
+  /* with the money off, the three tiles before More are the rotation's: the soil, not the cash */
+  .fut-dock:not(.is-more):not(.is-money) .fut-tile--soil { display: block; }
+  .fut-dock:not(.is-more):not(.is-money) .fut-tile--cash { display: none; }
+  .fut-dock .fut-dock__row--mid > .fut-money { grid-column: 2; align-self: center; height: 38px; padding: 0 10px; font-size: 13.5px; }
+  .fut-chip .fut-chip__after { font-size: 12px; }
+  .fut-chip .fut-chip__link, .fut-chip .fut-chip__link svg { width: 14px; height: 14px; }
+}
+@media (max-width: 640px) {
+  /* just the coin on a phone (its words stay for screen readers) */
+  .fut-dock .fut-money { width: 44px; padding: 0; justify-content: center; }
+  .fut-dock .fut-money span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+}
+/* short landscape: the coin only, beside More */
+@media (max-height: 520px) {
+  .fut-dock .fut-money { width: 40px; height: 38px; padding: 0; justify-content: center; }
+  .fut-dock .fut-money span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+}
diff --git a/src/styles/rotation.css b/src/styles/rotation.css
new file mode 100644
index 0000000..36e322b
--- /dev/null
+++ b/src/styles/rotation.css
@@ -0,0 +1,231 @@
+/* The rotation ribbon, field stories, rotation check, plan switch and money for "Plan my next
+   seasons" (src/screens/rotationRibbon.js, src/screens/plansPanel.js). Track D.
+   Imported at the top of styles.css, so selectors here carry one more class than the plain rules
+   there (".plans .plan-cell", ".story .plan-cell") where both style the same thing. */
+
+.plans {
+  --rib-old: .5;            /* the faded past seasons */
+  --rib-name-w: 168px;      /* the field column */
+  --rib-cell-w: 58px;
+  --rib-corn: #e3b23c;
+  --rib-beans: #7fb069;
+  --rib-grain: #c99a5b;
+  --rib-other: #b9a3d6;
+  --rib-nitrogen: #3f8a4f;
+  --rib-break: #3f78a8;
+  --rib-repeat: #c7792b;
+  --rib-family: #9c8a7a;
+  --rib-cover: #6f9a57;
+}
+
+/* ---- the plan switch ---- */
+.rib-switch {
+  display: flex; flex-wrap: wrap; gap: 3px; margin-top: 14px; padding: 3px; width: fit-content; max-width: 100%;
+  border-radius: 16px; background: var(--tile); box-shadow: inset 0 0 0 2px var(--tile-line);
+}
+.rib-switch__seg {
+  display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 12px; border-radius: 13px;
+  font-size: 14.5px; font-weight: 600; color: var(--ink-soft);
+}
+.rib-switch__seg:hover { color: var(--ink); background: var(--tile-hover); }
+.rib-switch__seg.is-on { background: var(--cream); color: var(--ink); box-shadow: inset 0 0 0 2px var(--green-dark), 0 2px 0 var(--green-dark); }
+.plans .rib-switch__seg:focus-visible { outline: 3px solid var(--green-dark); outline-offset: 2px; box-shadow: none; }
+.rib-switch__icon { display: inline-grid; place-items: center; width: 20px; height: 20px; flex: none; }
+.rib-switch__icon svg, .rib-switch__icon img { width: 20px; height: 20px; }
+.rib-switch__badge {
+  padding: 1px 7px; border-radius: 999px; background: var(--green); color: var(--green-ink);
+  font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
+}
+.rib-switch__note { margin-top: 6px; font-size: 13.5px; line-height: 1.4; color: var(--ink-soft); }
+
+/* ---- the ribbon ---- */
+.rib-wrap { margin-top: 14px; }
+.rib { width: 100%; border-collapse: separate; border-spacing: 0 6px; table-layout: fixed; }
+.rib thead th { padding: 0 4px 2px; font-size: 12.5px; font-weight: 700; color: var(--ink-soft); text-align: center; }
+.rib thead .rib__fieldh { width: var(--rib-name-w); text-align: left; padding-left: 2px; }
+.rib__was { display: block; font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
+.rib thead .rib__past, .rib td.rib__past > * { opacity: var(--rib-old); }
+.rib td { padding: 0; text-align: center; vertical-align: middle; }
+.rib__row > td, .rib__row > th { background: var(--paper); }
+.rib__row > th { border-radius: 14px 0 0 14px; }
+.rib__row > td:last-child { border-radius: 0 14px 14px 0; }
+.rib__row.is-open > th, .rib__row.is-open > td { background: #fff3dd; }
+.rib__row.is-open > th { border-bottom-left-radius: 0; }
+.rib__row.is-open > td:last-child { border-bottom-right-radius: 0; }
+
+.rib__fieldc { padding: 0; text-align: left; }
+.rib__open {
+  width: 100%; min-height: 48px; display: grid; grid-template-columns: 1fr auto; grid-template-areas: "name chev" "acres chev" "verdict chev";
+  align-items: center; column-gap: 6px; padding: 6px 8px 6px 10px; border-radius: 14px 0 0 14px; text-align: left;
+}
+.rib__open:hover { background: var(--tile-hover); }
+.plans .rib__open:focus-visible { outline: 3px solid var(--green-dark); outline-offset: -3px; box-shadow: none; }
+.rib__name { grid-area: name; font-size: 15px; font-weight: 700; color: var(--ink); overflow-wrap: anywhere; }
+.rib__acres { grid-area: acres; font-size: 12px; color: var(--ink-soft); }
+.rib__verdict {
+  grid-area: verdict; justify-self: start; margin-top: 3px; padding: 1px 7px; border-radius: 8px; max-width: 100%;
+  font-size: 11.5px; font-weight: 600; line-height: 1.3; background: #eef8ec; color: var(--green-ink); box-shadow: inset 0 0 0 1.5px #a9d6b4;
+}
+.rib__verdict--keepsSame, .rib__verdict--repeatsLater, .rib__verdict--onceMore { background: #fff1dc; color: #7a4a17; box-shadow: inset 0 0 0 1.5px #e7bf86; }
+.rib__chev { grid-area: chev; width: 18px; height: 18px; color: var(--ink-soft); transition: transform .15s; }
+.rib__open[aria-expanded="true"] .rib__chev { transform: rotate(180deg); }
+
+.rib__cell { position: relative; height: 48px; }
+.rib .plan-crop { display: inline-grid; vertical-align: middle; }
+.rib .plan-crop--sm { width: 24px; height: 24px; border-radius: 7px; border-width: 1.5px; }
+.rib .plan-crop--sm svg { width: 16px; height: 16px; }
+.rib__link {
+  position: absolute; left: -9px; top: 50%; z-index: 1; width: 18px; height: 18px; margin-top: -9px;
+  display: grid; place-items: center; border-radius: 50%; background: var(--cream); color: var(--rib-family);
+  box-shadow: 0 0 0 1.5px currentColor;
+}
+.rib__link svg { width: 13px; height: 13px; }
+.rib__link--nitrogen { color: var(--rib-nitrogen); }
+.rib__link--break { color: var(--rib-break); }
+.rib__link--repeat { color: var(--rib-repeat); background: #fff1dc; }
+.rib__link--same-family { color: var(--rib-family); }
+.rib__link--cover { color: var(--rib-cover); }
+.rib__cell--repeat .plan-crop { border-color: var(--rib-repeat); }
+.rib__blanket {
+  position: absolute; right: 3px; bottom: 3px; width: 16px; height: 16px; display: grid; place-items: center;
+  border-radius: 6px; background: #e4f0da; color: var(--rib-cover);
+}
+.rib__blanket svg { width: 13px; height: 13px; }
+
+/* the acre split under each planned season */
+.rib__foot th, .rib__foot td { padding-top: 2px; vertical-align: top; }
+.rib__splith { font-size: 11.5px; font-weight: 700; color: var(--ink-soft); padding-left: 10px; }
+.rib-split { font-size: 11px; line-height: 1.3; color: var(--ink-soft); }
+.rib-split__words { display: block; white-space: nowrap; }
+.rib-split__bar { display: flex; height: 5px; margin: 3px 6px 0; border-radius: 3px; overflow: hidden; background: var(--tile); }
+.rib-split__seg { display: block; min-width: 2px; }
+.rib-split__seg--corn { background: var(--rib-corn); }
+.rib-split__seg--soybeans { background: var(--rib-beans); }
+.rib-split__seg--grain { background: var(--rib-grain); }
+.rib-split__seg--other { background: var(--rib-other); }
+.rib-splitlist { display: none; list-style: none; margin-top: 6px; font-size: 12.5px; color: var(--ink-soft); }
+.rib-splitlist li { margin-top: 4px; }
+.rib-splitlist b { color: var(--ink); margin-right: 4px; }
+.rib-splitlist .rib-split__bar { margin: 3px 0 0; max-width: 260px; }
+
+.rib-legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 8px; list-style: none; font-size: 12.5px; color: var(--ink-soft); }
+.rib-legend__item { display: inline-flex; align-items: center; gap: 6px; }
+.rib-legend .rib__link { position: static; margin: 0; flex: none; }
+
+/* ---- a field's story, under its row ---- */
+.rib__story > td { padding: 0; text-align: left; background: #fff3dd; border-radius: 0 0 14px 14px; }
+.story { padding: 4px 12px 14px; font-size: 14px; line-height: 1.45; }
+.story__lead { font-size: 15px; color: var(--ink); }
+.story__seasons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 10px; list-style: none; }
+.story-card { min-width: 0; padding: 10px; border-radius: 12px; background: var(--cream); border: 2px solid #ead8c0; }
+.story-card__h { display: flex; align-items: center; gap: 8px; font-size: 14.5px; font-weight: 700; color: var(--ink); }
+.story-card__year { color: var(--ink-soft); }
+.story-card__row { margin-top: 6px; }
+.story-card__k { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
+.story-card__when svg { display: block; width: 100%; max-width: 300px; height: auto; margin-top: 4px; }
+.story-card__watch { margin-top: 6px; list-style: none; display: grid; gap: 4px; }
+.story-card__w { padding-left: 8px; border-left: 3px solid #e9a23b; }
+.story-card__w--careful, .story-card__w--stop { border-left-color: var(--rose-dark); }
+.story-card__w--info { border-left-color: var(--tile-line); }
+.story__whynot, .story__money { margin-top: 10px; }
+.story__money { color: var(--ink-soft); }
+.story__pick { margin-top: 12px; padding-top: 10px; border-top: 2px solid #ead8c0; }
+.story__pickh { font-size: 14px; font-weight: 700; color: var(--ink); }
+.story__cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 6px; }
+.story .plan-cell { flex-direction: column; align-items: center; gap: 4px; min-height: 44px; padding: 8px 6px; }
+.plan-cell__name { font-size: 13.5px; font-weight: 700; color: var(--ink); }
+.plan-cell__crops { display: inline-flex; gap: 3px; }
+.story .plan-cell .plan-crop { width: 24px; height: 24px; border-radius: 7px; border-width: 1.5px; }
+.story .plan-cell .plan-crop svg { width: 16px; height: 16px; }
+.plan-cell__cash { font-size: 12px; color: var(--ink-soft); }
+.story__picked { min-height: 1.4em; margin-top: 6px; font-size: 13.5px; color: var(--green-ink); }
+
+@media (prefers-reduced-motion: no-preference) {
+  .rib__story:not([hidden]) .story { animation: rib-story-in .18s ease-out both; }
+}
+@keyframes rib-story-in { from { opacity: 0; transform: translateY(-4px); } }
+@media (prefers-reduced-motion: reduce) {
+  .rib__chev { transition: none; }
+}
+
+/* ---- the rotation check ---- */
+.rot-check__list { list-style: none; margin-top: 6px; display: grid; gap: 4px; }
+.rot-check__row {
+  display: grid; grid-template-columns: 26px minmax(140px, auto) 1fr auto; align-items: baseline; gap: 4px 10px;
+  padding: 7px 10px; border-radius: 12px; background: var(--paper); font-size: 14px; line-height: 1.35;
+}
+/* wider screens: the five rows share one set of columns, so the values line up under each other */
+@media (min-width: 641px) {
+  @supports (grid-template-columns: subgrid) {
+    .rot-check__list { grid-template-columns: 26px max-content 1fr auto; column-gap: 10px; }
+    .rot-check__row { grid-column: 1 / -1; grid-template-columns: subgrid; }
+  }
+}
+.rot-check__icon { align-self: center; display: grid; place-items: center; width: 24px; height: 24px; color: var(--ink-soft); }
+.rot-check__icon svg { width: 20px; height: 20px; }
+.rot-check__row--repeats .rot-check__icon, .rot-check__row--repeat .rot-check__icon { color: var(--rib-repeat); }
+.rot-check__row--handoffs .rot-check__icon, .rot-check__row--nitrogen .rot-check__icon, .rot-check__row--soil .rot-check__icon { color: var(--rib-nitrogen); }
+.rot-check__row--cover .rot-check__icon { color: var(--rib-cover); }
+.rot-check__label { font-weight: 700; color: var(--ink); }
+.rot-check__value { color: var(--ink); }
+.rot-check__base { font-size: 12.5px; color: var(--ink-soft); white-space: nowrap; }
+.rot-check__row.is-better .rot-check__value { color: var(--green-ink); }
+
+/* ---- money, second ---- */
+.rot-money__line { margin-top: 4px; font-size: 13px; line-height: 1.45; color: var(--ink); }
+.rot-money__wrap { margin-top: 8px; overflow-x: auto; }
+.rot-money__table { width: 100%; min-width: 420px; border-collapse: collapse; font-size: 13px; }
+.rot-money__table th, .rot-money__table td { padding: 5px 8px; text-align: right; border-bottom: 1.5px solid #ead8c0; }
+.rot-money__table th:first-child { text-align: left; }
+.rot-money__table thead th { font-size: 11.5px; font-weight: 700; color: var(--ink-soft); vertical-align: bottom; }
+.rot-money__table tr.is-on th, .rot-money__table tr.is-on td { background: #eef8ec; }
+.rot-money__note { margin-top: 8px; font-size: 13px; line-height: 1.45; color: var(--ink-soft); }
+
+.rot-why { margin-top: 8px; font-size: 14px; line-height: 1.45; }
+.rot-watch__h, .rot-raw__h { margin-top: 10px; font-size: 13.5px; font-weight: 700; color: var(--ink); }
+.plans__list--raw { color: var(--ink-soft); font-size: 13px; }
+.plans__more .linkish { display: inline; margin: 0; padding: 2px 0; }
+.plans__farmhost { display: contents; }
+
+/* When to sow: which plan its dates follow */
+.plans__calfor { margin: 0 0 8px; font-size: 13px; color: var(--ink-soft); }
+.plans__calfor b { color: var(--ink); }
+
+/* the footer stays in reach while the rotation scrolls */
+.plans__mix.plans__mix--sticky {
+  position: sticky; bottom: 0; z-index: 2; margin-top: 16px;
+  box-shadow: 0 -6px 12px -6px rgb(94 66 50 / .25), inset 0 0 0 2px var(--tile-line);
+}
+
+/* ---- narrower ---- */
+@media (max-width: 900px) {
+  .plans { --rib-name-w: 136px; }
+  .story__seasons { grid-template-columns: 1fr; }
+}
+@media (max-width: 640px) {
+  .plans { --rib-name-w: 92px; }
+  .rib .rib__y--old { display: none; }        /* 2025 goes; 2026 stays, faded */
+  .rib__foot { display: none; }               /* the split as a list instead, under the table */
+  .rib-splitlist { display: block; }
+  .rib__open { padding: 5px 4px 5px 7px; column-gap: 2px; grid-template-columns: 1fr auto; }
+  .rib__name { font-size: 13.5px; }
+  .rib__verdict { font-size: 10.5px; padding: 1px 5px; }
+  .rib__chev { width: 14px; height: 14px; }
+  .rib .plan-crop { width: 26px; height: 26px; border-radius: 8px; }
+  .rib .plan-crop svg { width: 18px; height: 18px; }
+  .rib__link { left: -8px; width: 16px; height: 16px; margin-top: -8px; }
+  .rib__link svg { width: 11px; height: 11px; }
+  .story { padding: 4px 8px 12px; }
+  .story__cells { grid-template-columns: 1fr; }
+  .story .plan-cell { flex-direction: row; justify-content: space-between; }
+  .rot-check__row { grid-template-columns: 24px 1fr; }
+  .rot-check__value, .rot-check__base { grid-column: 2; }
+  /* three tabs side by side, inside the panel's width (no sideways scroll at 375 px) */
+  .plans .plans__tabs { display: flex; width: 100%; }
+  .plans .plans__tab { flex: 1 1 0; min-width: 0; height: auto; min-height: 36px; padding: 4px 6px; font-size: 13px; line-height: 1.15; }
+  .rib-switch { width: 100%; }
+  .rib-switch__seg { flex: 1 1 auto; justify-content: center; padding: 0 8px; font-size: 13.5px; }
+  /* the sticky footer on one line, so it doesn't cover a sixth of the phone */
+  .plans__mix.plans__mix--sticky { flex-wrap: nowrap; gap: 8px; padding: 7px 8px 7px 10px; font-size: 13px; line-height: 1.3; }
+  .plans__mix.plans__mix--sticky .btn { flex: none; height: 36px; padding: 0 12px; font-size: 13.5px; }
+}
diff --git a/src/ui/cropTip.js b/src/ui/cropTip.js
new file mode 100644
index 0000000..d256a33
--- /dev/null
+++ b/src/ui/cropTip.js
@@ -0,0 +1,319 @@
+// One shared crop-name tooltip for every crop icon: hover, keyboard focus, touch and Esc. Badges
+// carry data-crop-tip (one line, with an optional quieter data-crop-sub) or a control carries
+// data-crop-tip-list (up to 3 lines); installCropTips() wires one body-level #cropTip for the whole
+// app. No native title attributes on crop icons (they made double tooltips).
+//
+//   - Mouse and pen: shown 80 ms after pointerover on [data-crop-tip], hidden 150 ms after
+//     pointerout. The tip itself is hoverable (pointer-events:auto), so moving onto it keeps it open
+//     (WCAG 1.4.13). Moving to a second icon swaps the text at once.
+//   - Keyboard: on focusin (keyboard focus only) an element's own data-crop-tip-list (up to 3
+//     lines) or data-crop-tip (one line); hidden on focusout.
+//   - Esc: a window capture-phase keydown hides a visible tip and stops the event (immediately, so
+//     other window-capture handlers skip it too), so the first Esc closes only the tip and the next
+//     one reaches the panel.
+//   - Touch: a tap on a badge shows it at once (no preventDefault, so the tap still selects); it
+//     hides after 2.5 s, on the next pointerdown elsewhere, or on scroll.
+//   - Also hidden on scroll (a keyboard tip follows its control while it stays in view), resize,
+//     visibilitychange and hideCropTip() (a drag, the island turning, the reel moving). Never shown
+//     while the jar test is open (body.jar-open).
+//   - Placement: tipPlace() centres it above the icon, flips it below near the top, and clamps it
+//     inside the viewport and the icon's closest [data-tip-bounds] (the panel).
+//
+// The tip is aria-hidden: screen readers get the crop from the badge's aria-label, or from the
+// control's own label, so nothing is read twice.
+import { cropIcon } from './cropIcons.js';
+import { APP_CROP } from '../plan/farmInput.js';
+import { CROP_NAME } from '../plan/planNames.js';
+
+export const KEY_NAME = {
+  corn: 'Corn', soybeans: 'Soybeans', wheat: 'Wheat', barley: 'Barley', oats: 'Oats', sorghum: 'Sorghum',
+  alfalfa: 'Alfalfa', hay: 'Hay', pasture: 'Pasture', fallow: 'Fallow', other: 'Other crop',
+};
+
+const SHOW_MS = 80;
+const HIDE_MS = 150;
+const TOUCH_MS = 2500;
+const MAX_LINES = 3;
+
+const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+const coverName = (cover) => (typeof cover === 'string' ? (CROP_NAME[cover] || cover).toLowerCase() : 'winter');
+
+/** A crop's name as the tip says it: 'Soybeans + cereal rye cover'. */
+export function cropName(cropId, { key, cover, name } = {}) {
+  const base = name || (cropId && CROP_NAME[cropId]) || KEY_NAME[key || APP_CROP[cropId]] || KEY_NAME.other;
+  return cover ? `${base} + ${coverName(cover)} cover` : base;
+}
+
+/**
+ * A crop icon with its tooltip data. Standalone it is role="img" with an aria-label; inControl it is
+ * aria-hidden (the button or radio around it names the crops). `cls` is the wrapper's class list:
+ * 'plan-crop' (the boxed tile) by default, 'crop-ico' for a bare icon inside a styled control. The
+ * size modifier goes on the first class; the cover dot is always .plan-crop__cover.
+ */
+export function cropBadge(cropId, { key, name, year, after, cover, sub, size = 'md', inControl = false, focusable = false, cls = 'plan-crop' } = {}) {
+  const label = cropName(cropId, { key, cover, name });
+  const afterName = after ? cropName(after).toLowerCase() : '';
+  const subLine = sub ?? [year, afterName ? `after ${afterName}` : ''].filter(Boolean).join(' · ');
+  const aria = `${year ? `${year}: ` : ''}${label}${afterName ? `, after ${afterName}` : ''}`;
+  const icon = cropIcon(key || APP_CROP[cropId] || 'other');
+  const dot = cover ? '<span class="plan-crop__cover" aria-hidden="true"></span>' : '';
+  const a11y = inControl ? ' aria-hidden="true"' : ` role="img" aria-label="${esc(aria)}"`;
+  const tab = focusable && !inControl ? ' tabindex="0"' : '';
+  const subAttr = subLine ? ` data-crop-sub="${esc(subLine)}"` : '';
+  const first = String(cls).trim().split(/\s+/)[0] || 'plan-crop';
+  return `<span class="${esc(cls)} ${esc(first)}--${esc(size)}"${a11y}${tab} data-crop-tip="${esc(label)}"${subAttr}>${icon}${dot}</span>`;
+}
+
+/** The attribute for a control naming several crops: ' data-crop-tip-list="2027 Soybeans;2028 Corn"'. */
+export function tipListAttr(items = []) {
+  const list = items.map(({ year, cropId, cover }) => `${year ?? ''} ${cropName(cropId, { cover })}`.trim()).join(';');
+  return ` data-crop-tip-list="${esc(list)}"`;
+}
+
+/** The tip's lines for an element, from its dataset (at most 3). */
+export function tipLines(el) {
+  const d = el?.dataset ?? {};
+  if (d.cropTipList) return d.cropTipList.split(';').map((s) => s.trim()).filter(Boolean).slice(0, MAX_LINES).map((name) => ({ name, sub: '' }));
+  if (d.cropTip) return [{ name: d.cropTip, sub: d.cropSub ?? '' }];
+  return [];
+}
+
+/**
+ * Where the tip goes, in whole pixels: centred above the anchor; below it when above would come
+ * within `gap` of the top (of the viewport, or of the bounds); then clamped `gap` inside the
+ * viewport and the bounds. anchor and bounds are rects ({left, top, right, bottom, width?, height?}),
+ * tip is {width, height}, viewport is {width, height}.
+ */
+export function tipPlace({ anchor, tip, viewport, bounds = null, gap = 8 } = {}) {
+  const a = rectOf(anchor);
+  const tw = Math.max(0, tip?.width ?? 0), th = Math.max(0, tip?.height ?? 0);
+  const vw = viewport?.width ?? Infinity, vh = viewport?.height ?? Infinity;
+  const b = bounds ? rectOf(bounds) : null;
+  const left = Math.max(0, b ? b.left : 0) + gap;
+  const right = Math.min(vw, b ? b.right : Infinity) - gap;
+  const top = Math.max(0, b ? b.top : 0) + gap;
+  const bottom = Math.min(vh, b ? b.bottom : Infinity) - gap;
+
+  let x = a.left + a.width / 2 - tw / 2;
+  x = Math.min(x, right - tw);
+  x = Math.max(x, left); // a tip wider than the room keeps its left edge in view
+  let y = a.top - gap - th;
+  let below = false;
+  if (y < top) {
+    y = a.bottom + gap;
+    below = true;
+    if (y + th > bottom && a.top - gap - th >= gap) { y = a.top - gap - th; below = false; } // no room below either: stay above, inside the viewport
+  }
+  y = Math.max(gap, Math.min(y, vh - gap - th));
+  return { x: Math.round(x), y: Math.round(y), below };
+}
+
+function rectOf(r = {}) {
+  const left = r.left ?? r.x ?? 0, top = r.top ?? r.y ?? 0;
+  const width = r.width ?? ((r.right ?? left) - left), height = r.height ?? ((r.bottom ?? top) - top);
+  return { left, top, width, height, right: r.right ?? left + width, bottom: r.bottom ?? top + height };
+}
+
+// ---------------------------------------------------------------- the live tip (one per app)
+let installed = null;
+let live = null; // { hide } while installed with a real document
+
+const ANCHOR = '[data-crop-tip]';
+
+/** Wires the shared tip once; later calls return the same handle. */
+export function installCropTips({ doc = globalThis.document, win = globalThis.window } = {}) {
+  if (installed) return installed;
+  if (!doc?.body || !win?.addEventListener) {
+    installed = { hide() {}, dispose() { installed = null; } };
+    return installed;
+  }
+
+  const el = doc.createElement('div');
+  el.id = 'cropTip';
+  el.className = 'crop-tip';
+  el.setAttribute('aria-hidden', 'true');
+  el.hidden = true;
+  doc.body.appendChild(el);
+
+  let anchor = null; // the element the tip is for (shown, or about to be)
+  let source = null; // 'pointer' | 'focus' | 'touch'
+  let showTimer = 0, hideTimer = 0, touchTimer = 0;
+  const clear = (t) => { if (t) win.clearTimeout(t); return 0; };
+  const clearAll = () => { showTimer = clear(showTimer); hideTimer = clear(hideTimer); touchTimer = clear(touchTimer); };
+  const blocked = () => doc.body.classList.contains('jar-open');
+  // (a tip left up when the jar test opened is hidden by CSS: it must not eat the jar's Esc)
+  const visible = () => !el.hidden && !blocked();
+
+  function render(lines) {
+    const rows = lines.map(({ name, sub }) => {
+      const row = doc.createElement('span');
+      row.className = 'crop-tip__row';
+      const b = doc.createElement('b');
+      b.textContent = name;
+      row.appendChild(b);
+      if (sub) {
+        const s = doc.createElement('span');
+        s.textContent = sub;
+        row.appendChild(s);
+      }
+      return row;
+    });
+    el.replaceChildren(...rows);
+    el.classList.toggle('crop-tip--list', lines.length > 1);
+  }
+
+  function place() {
+    if (!anchor) return;
+    const icon = anchor.getBoundingClientRect();
+    const boundsEl = anchor.closest?.('[data-tip-bounds]');
+    const bounds = boundsEl ? boundsEl.getBoundingClientRect() : null;
+    const p = tipPlace({
+      anchor: icon,
+      tip: { width: el.offsetWidth, height: el.offsetHeight },
+      viewport: { width: win.innerWidth || doc.documentElement.clientWidth, height: win.innerHeight || doc.documentElement.clientHeight },
+      bounds,
+    });
+    el.style.transform = `translate(${p.x}px, ${p.y}px)`;
+    el.classList.toggle('is-below', p.below);
+  }
+
+  function show(target, how, lines = tipLines(target)) {
+    if (!target?.isConnected || !lines.length || blocked()) { hide(); return; }
+    clearAll(); // (a touch's 2.5 s goes too: a touch show sets its own again)
+    anchor = target;
+    source = how;
+    render(lines);
+    el.hidden = false;
+    place();
+  }
+
+  function hide() {
+    clearAll();
+    anchor = null;
+    source = null;
+    if (!el.hidden) {
+      el.hidden = true;
+      el.replaceChildren();
+    }
+  }
+
+  const inside = (node, root) => !!(node && root && (node === root || root.contains?.(node)));
+
+  // ---- mouse and pen
+  const onOver = (e) => {
+    if (e.pointerType === 'touch') return;
+    if (e.buttons && !visible()) return; // a button held: a drag or a turn of the island, not a hover
+    if (inside(e.target, el)) { hideTimer = clear(hideTimer); return; } // onto the tip: keep it
+    const t = e.target.closest?.(ANCHOR);
+    if (!t) return;
+    if (t === anchor) { hideTimer = clear(hideTimer); return; }
+    if (visible()) { show(t, 'pointer'); return; } // a second icon: swap at once
+    hideTimer = clear(hideTimer);
+    showTimer = clear(showTimer);
+    anchor = t;
+    source = 'pointer';
+    showTimer = win.setTimeout(() => { showTimer = 0; if (anchor === t) show(t, 'pointer'); }, SHOW_MS);
+  };
+  const onOut = (e) => {
+    if (e.pointerType === 'touch' || !anchor || source !== 'pointer') return;
+    const from = e.target;
+    if (!inside(from, anchor) && !inside(from, el)) return;
+    const to = e.relatedTarget;
+    if (inside(to, anchor) || inside(to, el)) return;
+    if (!visible()) { showTimer = clear(showTimer); anchor = null; source = null; return; }
+    hideTimer = clear(hideTimer);
+    hideTimer = win.setTimeout(() => { hideTimer = 0; hide(); }, HIDE_MS);
+  };
+
+  // ---- keyboard focus (not a mouse click's focus: the hover already named it)
+  const keyboardFocus = (t) => {
+    try { return t.matches(':focus-visible'); } catch { return true; }
+  };
+  const onFocusIn = (e) => {
+    const t = e.target;
+    if (!t?.dataset || (!t.dataset.cropTip && !t.dataset.cropTipList)) return;
+    if (!keyboardFocus(t)) return;
+    show(t, 'focus');
+  };
+  const onFocusOut = (e) => {
+    if (source === 'focus' && e.target === anchor) hide();
+  };
+
+  // ---- touch, and any press elsewhere
+  const onDown = (e) => {
+    const t = e.target.closest?.(ANCHOR);
+    if (e.pointerType === 'touch' && t) {
+      show(t, 'touch');
+      touchTimer = clear(touchTimer);
+      if (visible()) touchTimer = win.setTimeout(() => { touchTimer = 0; hide(); }, TOUCH_MS);
+      return;
+    }
+    if ((visible() || anchor) && !inside(e.target, anchor) && !inside(e.target, el)) hide();
+  };
+
+  // ---- Esc first, before any panel's own Esc
+  const onKey = (e) => {
+    if (e.key !== 'Escape' || !visible()) return;
+    hide();
+    // (immediate too: other window-capture Esc handlers, such as the farm view's, sit on this same
+    // target, where stopPropagation alone would let them run)
+    e.stopImmediatePropagation?.();
+    e.stopPropagation();
+    e.preventDefault();
+  };
+
+  const onAway = () => { if (visible() || anchor) hide(); };
+  // A scroll hides a hover or touch tip. A keyboard tip follows its control instead: Tab to a control
+  // out of view scrolls it in (that scroll lands just after the focusin), and hiding then would mean
+  // the tip never showed. It goes once the control scrolls out of the viewport or its panel.
+  const onScroll = () => {
+    if (source === 'focus' && visible() && anchor?.isConnected && doc.activeElement === anchor) {
+      const r = anchor.getBoundingClientRect();
+      const boundsEl = anchor.closest?.('[data-tip-bounds]');
+      const b = boundsEl ? boundsEl.getBoundingClientRect() : null;
+      const vw = win.innerWidth || doc.documentElement.clientWidth, vh = win.innerHeight || doc.documentElement.clientHeight;
+      const inView = r.bottom > Math.max(0, b ? b.top : 0) && r.top < Math.min(vh, b ? b.bottom : vh)
+        && r.right > Math.max(0, b ? b.left : 0) && r.left < Math.min(vw, b ? b.right : vw);
+      if (inView) { place(); return; }
+    }
+    onAway();
+  };
+  const onVisibility = () => { if (doc.visibilityState === 'hidden') onAway(); };
+
+  doc.addEventListener('pointerover', onOver);
+  doc.addEventListener('pointerout', onOut);
+  doc.addEventListener('focusin', onFocusIn);
+  doc.addEventListener('focusout', onFocusOut);
+  doc.addEventListener('pointerdown', onDown, { capture: true, passive: true });
+  win.addEventListener('keydown', onKey, true);
+  win.addEventListener('scroll', onScroll, { capture: true, passive: true });
+  win.addEventListener('resize', onAway);
+  doc.addEventListener('visibilitychange', onVisibility);
+
+  live = { hide };
+  installed = {
+    hide,
+    dispose() {
+      hide();
+      doc.removeEventListener('pointerover', onOver);
+      doc.removeEventListener('pointerout', onOut);
+      doc.removeEventListener('focusin', onFocusIn);
+      doc.removeEventListener('focusout', onFocusOut);
+      doc.removeEventListener('pointerdown', onDown, { capture: true });
+      win.removeEventListener('keydown', onKey, true);
+      win.removeEventListener('scroll', onScroll, { capture: true });
+      win.removeEventListener('resize', onAway);
+      doc.removeEventListener('visibilitychange', onVisibility);
+      el.remove();
+      live = null;
+      installed = null;
+    },
+  };
+  return installed;
+}
+
+/** Hides the tip if it is showing (a drag starting, the island turning, the reel moving). */
+export function hideCropTip() {
+  live?.hide();
+}
