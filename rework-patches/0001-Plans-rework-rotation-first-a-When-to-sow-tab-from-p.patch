+    assert.match(html, /<dt>Best sown<\/dt><dd>Apr 15 to May 9 /);
+    assert.match(html, /<dt>Most farms plant<\/dt>/);
+    assert.match(html, /<dt>Lately half are in by<\/dt><dd>May 6 \(2021–2025, state-wide\)/);
