+    assert.ok(key(radios[1], 'End'));
+    assert.ok(key(radios[2], 'ArrowRight')); // wraps
+    assert.ok(key(radios[0], 'ArrowLeft'));
+    assert.ok(key(radios[2], 'Home'));
+    assert.equal(key(radios[0], 'Tab'), false);
+    listeners.click({ target: radios[1] });
